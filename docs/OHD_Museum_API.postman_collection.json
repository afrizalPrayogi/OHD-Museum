              "raw": "{\n  \"name\": \"Affandi\",\n  \"slug\": \"affandi\",\n  \"biography\": \"Affandi Koesoema adalah seorang pelukis maestro ekspresionis ternama Indonesia yang diakui dunia internasional.\",\n  \"portraitUrl\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n  \"eraPeriod\": \"Modern Indonesia\",\n  \"birthYear\": 1907,\n  \"deathYear\": 1990,\n  \"isProminent\": true,\n  \"locale\": \"id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/artists",
              "host": ["{{baseUrl}}"],
              "path": ["artists"]
            }
          }
        }
      ]
    },
